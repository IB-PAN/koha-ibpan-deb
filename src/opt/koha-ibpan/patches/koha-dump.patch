@@ -30,6 +30,11 @@
 # Make sure the files we create are not accessible by anyone else.
 umask 0077
 
+# Set current process's CPU and IO niceness, so that the script doesn't steal resources from more important tasks.
+# These values are also inherited by children processes.
+renice -n 10 -p $$ || ( [ "$quiet" = "no" ] && echo "Failed setting nice value. This is a harmless error." )
+ionice -c 3 -p $$ || ( [ "$quiet" = "no" ] && echo "Failed setting ionice idle class value. This is a harmless error." )
+
 usage()
 {
     local scriptname=$(basename $0)
@@ -75,7 +80,7 @@
